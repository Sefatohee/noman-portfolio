---
import Container from "../layouts/Container.astro";
import bgContact from "../assets/Group 6.png";
import characterArt from "../assets/character-art.png";
---

<section class="py-16 sm:py-24">
    <Container>
        <div class="relative flex min-h-43 items-center rounded-lg">
            <div
                class="absolute inset-0 z-0 bg-cover bg-center bg-no-repeat rounded-lg"
                style={`background-image: url("${bgContact.src}");`}
            >
            </div>
            <div
                class="absolute inset-0 z-10 bg-linear-to-r from-[#b026ff]/35 via-[#5934d5]/20 to-[#171b4d]/35 rounded-lg"
            >
            </div>

            <div
                class="relative z-30 flex flex-col items-start gap-6 px-6 py-16 sm:px-10"
            >
                <h2
                    class="m-0  font-display text-3xl font-bold uppercase leading-none text-white sm:text-4xl"
                >
                    LET'S <span class="text-[#20adff]"> TALK</span>
                </h2>

                <a
                    href="#contact"
                    class="rounded-full bg-[#20adff] px-5 py-2 font-sans text-sm font-bold text-[#171b2c] transition hover:bg-[#56c1ff]"
                >
                    Get Free Quote
                </a>
            </div>

            <div
                class="pointer-events-none absolute bottom-0 right-0 z-20 h-[125%] sm:right-12"
            >
                <img
                    src={characterArt.src}
                    alt=""
                    role="presentation"
                    loading="lazy"
                    class="h-full w-auto object-contain"
                />
            </div>
        </div>
    </Container>
</section>
