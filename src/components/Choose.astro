---
import Container from "../layouts/Container.astro";

const reasons = [
	{
		title: "Ship-ready quality",
		description:
			"Every asset matches your style guide and passes an in-house art review before hand-off - you get work that ships, not work you have to fix.",
	},
	{
		title: "Low-risk start",
		description:
			"Begin with a small paid trial batch. See our real output and pipeline fit before you commit budget to full production.",
	},
	{
		title: "Engine-ready delivery",
		description:
			"Spine rigs, sprite sheets and atlases exported for Unity, Cocos or your engine - drop them into the build, no re-export loop on your side.",
	},
];
---

<section class="py-16 sm:py-24" aria-labelledby="choose-title">
	<Container>
		<h2
			id="choose-title"
			class="m-0 mb-6 font-display text-4xl font-bold uppercase leading-none text-white sm:mb-8 sm:text-5xl"
		>
			Why <span class="text-[#20aaff]">Choose</span>
		</h2>

		<div class="choose-grid">
			{
				reasons.map((reason) => (
					<article class="choose-card">
						<h3>{reason.title}</h3>
						<p>{reason.description}</p>
					</article>
				))
			}
		</div>
	</Container>
</section>

<style>
	.choose-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.75rem;
	}

	.choose-card {
		display: flex;
		min-height: 168px;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		border: 1px solid #087fca;
		border-radius: 0.9rem;
		padding: 1.5rem;
		text-align: center;
		background: rgba(35, 42, 57, 0.72);
		transition:
			transform 220ms ease,
			border-color 220ms ease,
			box-shadow 220ms ease,
			background-color 220ms ease;
	}

	.choose-card:hover,
	.choose-card:focus-within {
		transform: translateY(-6px);
		border-color: #20aaff;
		background: rgba(35, 48, 70, 0.9);
		box-shadow: 0 12px 28px rgba(0, 170, 255, 0.16);
	}

	.choose-card h3 {
		margin: 0 0 0.9rem;
		color: #20aaff;
		font-family: var(--font-display, sans-serif);
		font-size: 0.9rem;
		font-weight: 700;
		line-height: 1.1;
		text-transform: uppercase;
		transition: color 220ms ease;
	}

	.choose-card:hover h3,
	.choose-card:focus-within h3 {
		color: #68c9ff;
	}

	.choose-card p {
		max-width: 290px;
		margin: 0;
		color: #f5f5f7;
		font-family: var(--font-sans, sans-serif);
		font-size: 0.82rem;
		line-height: 1.25;
	}

	@media (prefers-reduced-motion: reduce) {
		.choose-card,
		.choose-card h3 {
			transition: none;
		}
	}

	@media (max-width: 767px) {
		.choose-grid {
			grid-template-columns: 1fr;
		}

		.choose-card {
			min-height: 150px;
		}
	}
</style>
