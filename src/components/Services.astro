---
import Container from "../layouts/Container.astro";
import service1 from "../assets/Service_Art.png";
import service2 from "../assets/Service_Assets.png";
import service3 from "../assets/Service_SpineAnimation.png";

const services = [
    {
        title: "Brand Identity",
        label: "Image placeholder 01",
        tone: "from-[#7d3cff] via-[#243f98] to-[#1d212d]",
        serviceUrl: service1.src,
    },
    {
        title: "Digital Design",
        label: "Image placeholder 02",
        tone: "from-[#ff704d] via-[#8435aa] to-[#1d212d]",
        serviceUrl: service2.src,
    },
    {
        title: "Motion Graphics",
        label: "Image placeholder 03",
        tone: "from-[#19b6ff] via-[#2453a8] to-[#1d212d]",
        serviceUrl: service3.src,
    },
];
---

<section class="page-section" aria-labelledby="services-title">
    <Container>
        <div class="services-slider" data-services-slider>
            <div class="services-header">
                <h2
                    id="services-title"
                    class="m-0 font-display text-4xl font-bold uppercase leading-none text-[#202938] sm:text-5xl"
                >
                    Our <span class="text-[#087fca]">Services</span>
                </h2>

                <div class="services-controls" aria-label="Services controls">
                    <button
                        class="slider-arrow"
                        type="button"
                        data-slide-previous
                        aria-label="Previous service"
                    >
                        <span aria-hidden="true">&#8592;</span>
                    </button>
                    <button
                        class="slider-arrow"
                        type="button"
                        data-slide-next
                        aria-label="Next service"
                    >
                        <span aria-hidden="true">&#8594;</span>
                    </button>
                </div>
            </div>

            <div class="services-viewport swiper" data-services-viewport>
                <div class="services-track swiper-wrapper">
                    {
                        services.map((service, index) => (
                            <article
                                class={`service-card swiper-slide ${index === 0 ? "is-active" : ""}`}
                                aria-hidden={index === 0 ? "false" : "true"}
                            >
                                <div
                                    class={`service-visual ${service.tone}`}
                                    style={`background-image: url("${service.serviceUrl}");`}
                                >
                                    <div class="service-overlay">
                                        <span class="service-number">
                                            {String(index + 1).padStart(2, "0")}
                                        </span>

                                        <div class="service-copy">
                                            <p>{service.label}</p>
                                            <h3>{service.title}</h3>
                                        </div>
                                    </div>
                                </div>
                            </article>
                        ))
                    }
                </div>
            </div>

            <div class="services-dots" data-slide-dots>
                {
                    services.map((_, index) => (
                        <button
                            class={`slider-dot ${index === 0 ? "is-active" : ""}`}
                            type="button"
                            data-slide-dot={index}
                            aria-label={`Show service ${index + 1}`}
                            aria-current={index === 0 ? "true" : "false"}
                        />
                    ))
                }
            </div>
        </div>
    </Container>
</section>

<script>
    import Swiper from "swiper";
    import { EffectCoverflow } from "swiper/modules";
    import "swiper/css";
    import "swiper/css/effect-coverflow";

    const slider = document.querySelector("[data-services-slider]");

    if (slider) {
        const viewport = slider.querySelector<HTMLElement>(
            "[data-services-viewport]",
        );
        const slides = [...slider.querySelectorAll<HTMLElement>(".service-card")];
        const dots = [...slider.querySelectorAll<HTMLButtonElement>("[data-slide-dot]")];
        const prevButton = slider.querySelector<HTMLButtonElement>(
            "[data-slide-previous]",
        );
        const nextButton = slider.querySelector<HTMLButtonElement>(
            "[data-slide-next]",
        );

        if (viewport) {
            const updateSliderState = (swiper: Swiper) => {
                slides.forEach((slide) => {
                    const isActive = slide.classList.contains("swiper-slide-active");
                    slide.classList.toggle("is-active", isActive);
                    slide.setAttribute("aria-hidden", String(!isActive));
                });

                dots.forEach((dot, index) => {
                    const isActive = index === swiper.realIndex;
                    dot.classList.toggle("is-active", isActive);
                    dot.setAttribute("aria-current", String(isActive));
                });
            };

            const swiper = new Swiper(viewport, {
                modules: [EffectCoverflow],
                slidesPerView: "auto",
                centeredSlides: true,
                spaceBetween: 20,
                loop: true,
                speed: 600,
                grabCursor: true,
                effect: "coverflow",
                coverflowEffect: {
                    rotate: 0,
                    stretch: 0,
                    depth: 120,
                    modifier: 1,
                    slideShadows: false,
                },
                on: {
                    init: updateSliderState,
                    slideChange: updateSliderState,
                },
            });

            prevButton?.addEventListener("click", () => swiper.slidePrev());
            nextButton?.addEventListener("click", () => swiper.slideNext());
            dots.forEach((dot, index) =>
                dot.addEventListener("click", () => swiper.slideToLoop(index)),
            );
        }
    }
</script>

<style>
    .services-slider {
        color: var(--ink);
    }

    .services-header {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .services-controls {
        display: flex;
        gap: 0.75rem;
    }

    .slider-arrow {
        display: grid;
        place-items: center;
        width: 48px;
        height: 48px;
        border: 1px solid rgba(81, 110, 163, 0.45);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.7);
        color: #202938;
        font-size: 1.45rem;
        box-shadow: 0 12px 30px rgba(17, 29, 53, 0.08);
        transition:
            transform 180ms ease,
            border-color 180ms ease,
            background-color 180ms ease,
            color 180ms ease;
    }

    .slider-arrow:hover,
    .slider-arrow:focus-visible {
        border-color: rgba(8, 127, 202, 0.8);
        background: #20aaff;
        color: #fff;
        transform: translateY(-1px);
    }

    .services-viewport {
        overflow: hidden;
        padding-bottom: 0.5rem;
    }

    .services-track {
        align-items: stretch;
    }

    .service-card {
        width: 65%;
        min-width: 65%;
        flex: 0 0 65%;
        height: auto;
        opacity: 0.58;
        filter: saturate(0.7);
        transition:
            opacity 260ms ease,
            filter 260ms ease;
    }

    .service-card.is-active {
        opacity: 1;
        filter: saturate(1);
    }

    .service-visual {
        position: relative;
        aspect-ratio: 1.57;
        min-height: clamp(260px, 32vw, 470px);
        overflow: hidden;
        border-radius: 30px;
        border: 1px solid rgba(255, 255, 255, 0.18);
        box-shadow: 0 26px 80px rgba(6, 14, 28, 0.2);
        background-size: cover;
        background-position: center;
    }

    .service-visual::before {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(
            180deg,
            rgba(11, 17, 27, 0.05) 0%,
            rgba(11, 17, 27, 0.14) 32%,
            rgba(11, 17, 27, 0.72) 100%
        );
    }

    .service-overlay {
        position: absolute;
        inset: 0;
        z-index: 1;
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 1rem;
        padding: clamp(1.2rem, 2vw, 2rem);
    }

    .service-number {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 3rem;
        height: 3rem;
        border: 1px solid rgba(255, 255, 255, 0.26);
        border-radius: 999px;
        background: rgba(9, 17, 29, 0.18);
        backdrop-filter: blur(10px);
        color: #f3f6ff;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.16em;
    }

    .service-copy {
        text-align: right;
    }

    .service-copy p {
        margin: 0 0 0.5rem;
        color: rgba(255, 255, 255, 0.78);
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
    }

    .service-copy h3 {
        margin: 0;
        color: #ffffff;
        font-size: clamp(1.5rem, 2vw, 2.4rem);
        font-weight: 700;
        letter-spacing: -0.05em;
        line-height: 1;
    }

    .services-dots {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.7rem;
        margin-top: 1.5rem;
    }

    .slider-dot {
        width: 14px;
        height: 14px;
        padding: 0;
        border: 2px solid rgba(56, 88, 170, 0.8);
        border-radius: 999px;
        background: transparent;
        transition:
            width 180ms ease,
            background-color 180ms ease,
            border-color 180ms ease,
            transform 180ms ease;
    }

    .slider-dot.is-active,
    .slider-dot:hover,
    .slider-dot:focus-visible {
        width: 34px;
        border-color: #20aaff;
        background: #20aaff;
        transform: scale(1.02);
    }

    @media (max-width: 640px) {
        .services-header {
            align-items: start;
            flex-direction: column;
        }

        .services-controls {
            width: 100%;
            justify-content: flex-end;
        }
    }

    @keyframes slide-in {
        from {
            opacity: 0;
            transform: translateX(20px);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }
</style>
